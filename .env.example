# ─────────────────────────────────────────────────────────────
# INSEDU · Variables de entorno (Etapa 1: Vercel + Supabase)
# Copiar a apps/web/.env.local para desarrollo local.
# NUNCA subir valores reales al repositorio.
# ─────────────────────────────────────────────────────────────

# Modo de datos: "synthetic" (Etapa 1, demostración) | "real" (Etapa 2, piloto)
INSEDU_DATA_MODE=synthetic

# Firma de la cookie de sesión de demostración (mínimo 32 caracteres; obligatoria con datos reales)
INSEDU_SESSION_SECRET=

# ── Persistencia de la demostración (Etapa 1) ──
# Sin estas variables todo vive en memoria (desarrollo local).
# En Vercel son obligatorias: cadena "Transaction pooler" (puerto 6543) de cada proyecto Supabase.
DATABASE_URL=
VAULT_DATABASE_URL=

# Proyecto Supabase PRINCIPAL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Proyecto Supabase BÓVEDA (solo lo usa el servicio de Salvaguarda, nunca el cliente)
VAULT_SUPABASE_URL=
VAULT_SUPABASE_SERVICE_ROLE_KEY=
# Llave maestra (32 bytes en base64) para derivar llaves por colegio.
# OBLIGATORIA cuando se usa VAULT_DATABASE_URL (todas las instancias deben compartirla).
# En Etapa 2 se reemplaza por Cloud KMS. Generar con: openssl rand -base64 32
VAULT_MASTER_KEY=

# AI Gateway · Gemini
# Tier: "free" (Etapa 1) | "paid" (Etapa 2, con acuerdo de procesamiento de datos)
AI_PROVIDER=gemini
AI_TIER=free
GEMINI_API_KEY=
# Proyectos nuevos: gemini-3.5-flash-lite (rápido) o gemini-3.8-flash (más capaz).
# Google limita los modelos 2.5 a quienes ya los usaban.
GEMINI_MODEL=gemini-3.5-flash-lite
# Tope diario de solicitudes al Copiloto por instancia, sumando todos los usuarios (por defecto 100)
AI_DAILY_LIMIT=100
