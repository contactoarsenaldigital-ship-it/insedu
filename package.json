{
  "name": "insedu",
  "private": true,
  "version": "0.1.0",
  "description": "INSEDU - Plataforma PWA de acompañamiento integral del estudiante (MVP Etapa 1)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @insedu/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "seed:print": "pnpm --filter @insedu/domain seed:print"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
